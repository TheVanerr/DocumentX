{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DocumentX DATA",
  "scopeName": "source.documentx-data",
  "patterns": [
    { "include": "#comments" },
    { "include": "#sections" },
    { "include": "#fields" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.separator.documentx-data",
          "match": "^# =+$"
        },
        {
          "name": "comment.line.number-sign.documentx-data",
          "match": "^#.*$"
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "name": "entity.name.section.documentx-data",
          "match": "^\\[[^\\]]+\\]\\s*$"
        }
      ]
    },
    "fields": {
      "patterns": [
        {
          "name": "meta.field.empty.documentx-data",
          "match": "^([^:\\n]+):\\s*$",
          "captures": {
            "1": { "name": "entity.name.tag.documentx-data" }
          }
        },
        {
          "name": "meta.field.filled.documentx-data",
          "match": "^([^:\\n]+):\\s*(.+)$",
          "captures": {
            "1": { "name": "entity.name.tag.documentx-data" },
            "2": { "name": "string.unquoted.documentx-data" }
          }
        }
      ]
    }
  }
}
